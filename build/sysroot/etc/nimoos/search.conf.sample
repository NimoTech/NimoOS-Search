[common]
RuntimePath = /var/run/nimoos
DataPath    = /var/lib/nimoos/search
LogPath     = /var/log/nimoos

[search]
BindHost              = 127.0.0.1
RerankerEnabled       = true
RerankerCandidates    = 8
DefaultTopK           = 20
MaxTopK               = 100
EmbedCacheSize        = 1000
EmbedCacheTtlSec      = 300
UserRootsCacheTtlSec  = 60
ParserTimeoutSec      = 10
QdrantUrl             = http://127.0.0.1:6333
QdrantGrpcPort        = 6334

[upstream]
ParserDiscoveryPath      = /var/run/nimoos/parser.url
NimoOSDiscoveryPath      = /var/run/nimoos/nimoos.url
GatewayDiscoveryPath     = /var/run/nimoos/management.url
MessageBusSocket         = /var/run/nimoos/message-bus.sock

[fileindex]
Enabled               = true
# Comma-separated roots to index by filename.
Roots                 = /DATA,/mnt,/media
# Comma-separated subtrees to never index/watch. Defaults to the NimoOS
# overlay-root system mounts that live under /mnt and /media — without this
# the boot scan would index the whole OS root filesystem (hundreds of thousands
# of files) and peg a CPU core for many minutes.
Exclude               = /media/root-ro,/media/root-rw,/mnt/overlay,/mnt/metadata
